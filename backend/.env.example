# ========================================
# 🔒 SECURITY - REQUIRED CONFIGURATION
# ========================================
# ⚠️ NEVER commit real secrets to version control!
# ⚠️ Generate strong random values for production!

# Database
DATABASE_URL=postgresql+asyncpg://imran:12345678@127.0.0.1:5432/altcare_dev
DATABASE_ECHO=False

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO / S3
# ⚠️ PRODUCTION: Change these credentials! Default values are insecure.
# Generate with: openssl rand -base64 32
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=altcare
MINIO_USE_SSL=False

# JWT Authentication
# ⚠️ REQUIRED: Generate a strong random secret (min 32 chars)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption (Fernet key for integration credentials)
# ⚠️ REQUIRED: Generate a Fernet key for encrypting sensitive data
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_ENCRYPTION_KEY=your-fernet-key-generate-with-cryptography

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Frontend base URL — used to build links in platform emails (password
# reset, email verification). Not the same as CORS_ORIGINS: that's a list.
FRONTEND_URL=http://localhost:3000

# Platform system email (password reset, email verification)
# Set EMAIL_PROVIDER to the one you're using: sendgrid | resend | mailgun |
# smtp2go | smtp. Only that provider's credentials need to be filled in —
# leave the rest blank. All send over SMTP relay (see
# app/core/system_email.py), so no per-provider SDK is required.
EMAIL_PROVIDER=
EMAIL_FROM_ADDRESS=noreply@altcare.health

# sendgrid
SENDGRID_API_KEY=

# resend
RESEND_API_KEY=

# mailgun — SMTP credentials from the Mailgun dashboard (per sending
# domain), not the general Mailgun API key. MAILGUN_SMTP_HOST=
# smtp.eu.mailgun.org for EU-region domains.
MAILGUN_SMTP_USERNAME=
MAILGUN_SMTP_PASSWORD=
MAILGUN_SMTP_HOST=smtp.mailgun.org

# smtp2go — from Sending > SMTP Users in the SMTP2GO dashboard
SMTP2GO_USERNAME=
SMTP2GO_PASSWORD=

# smtp — generic fallback for any other provider
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=True

# Google Sign-In — OAuth Client ID (Web application type), not a secret.
# Create one at https://console.cloud.google.com/apis/credentials with
# Authorized JavaScript origins: http://localhost:3000 (and your production
# origin). This value is also sent to the frontend to init the button.
GOOGLE_CLIENT_ID=

# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Payment (SSLCommerz)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_SANDBOX=True

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# OpenAI (for Phase 4 - AI/RAG)
OPENAI_API_KEY=

# Sentry
SENTRY_DSN=

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_LOGIN_PER_MINUTE=5
