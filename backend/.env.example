# ========================================
# 🔒 SECURITY - REQUIRED CONFIGURATION
# ========================================
# ⚠️ NEVER commit real secrets to version control!
# ⚠️ Generate strong random values for production!

# Database
DATABASE_URL=postgresql+asyncpg://imran:12345678@127.0.0.1:5432/altcare_dev
DATABASE_ECHO=False

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO / S3
# ⚠️ PRODUCTION: Change these credentials! Default values are insecure.
# Generate with: openssl rand -base64 32
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=altcare
MINIO_USE_SSL=False

# JWT Authentication
# ⚠️ REQUIRED: Generate a strong random secret (min 32 chars)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption (Fernet key for integration credentials)
# ⚠️ REQUIRED: Generate a Fernet key for encrypting sensitive data
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_ENCRYPTION_KEY=your-fernet-key-generate-with-cryptography

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Email (SendGrid)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@altcare.health

# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Payment (SSLCommerz)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_SANDBOX=True

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# OpenAI (for Phase 4 - AI/RAG)
OPENAI_API_KEY=

# Sentry
SENTRY_DSN=

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_LOGIN_PER_MINUTE=5
