# AltCare Environment Variables
# Copy this file to .env and fill in actual values

# ============================================================================
# Application
# ============================================================================
ENVIRONMENT=development  # development, staging, production
DEBUG=True
SECRET_KEY=your-super-secret-jwt-signing-key-change-this-in-production
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000

# ============================================================================
# Database
# ============================================================================
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/altcare
# For production managed database:
# DATABASE_URL=postgresql+asyncpg://user:pass@managed-db.provider.com:5432/altcare

# Database Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600

# ============================================================================
# Redis
# ============================================================================
REDIS_URL=redis://localhost:6379/0
# For production managed Redis:
# REDIS_URL=redis://user:pass@managed-redis.provider.com:6379/0

# ============================================================================
# Celery (uses Redis)
# ============================================================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ============================================================================
# MinIO / S3 Storage
# ============================================================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=altcare
MINIO_SECURE=False  # Set to True in production with HTTPS

# For Cloudflare R2 (production):
# MINIO_ENDPOINT=<account-id>.r2.cloudflarestorage.com
# MINIO_ACCESS_KEY=<r2-access-key>
# MINIO_SECRET_KEY=<r2-secret-key>
# MINIO_BUCKET=altcare-prod
# MINIO_SECURE=True

# ============================================================================
# OpenAI API (for AI/RAG features)
# ============================================================================
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_COMPLETION_MODEL=gpt-4o-mini
# Use gpt-4o for complex queries only (more expensive):
# OPENAI_ADVANCED_MODEL=gpt-4o

# Monthly budget limit (set in OpenAI dashboard)
OPENAI_MONTHLY_BUDGET=500

# ============================================================================
# Email Providers
# ============================================================================
# Primary: SendGrid
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here
SENDGRID_FROM_EMAIL=noreply@altcare.health
SENDGRID_FROM_NAME=AltCare

# Secondary: SMTP (fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=True

# ============================================================================
# SMS Providers
# ============================================================================
# Primary: Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Secondary: Banglalink SMS API (Bangladesh)
BANGLALINK_API_KEY=your-banglalink-api-key
BANGLALINK_SENDER_ID=AltCare

# ============================================================================
# Payment Gateways
# ============================================================================
# SSLCommerz (Bangladesh)
SSLCOMMERZ_STORE_ID=your-store-id
SSLCOMMERZ_STORE_PASSWORD=your-store-password
SSLCOMMERZ_SANDBOX=True  # Set to False in production

# Stripe (International)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ============================================================================
# Encryption (for storing integration credentials)
# ============================================================================
INTEGRATION_ENCRYPTION_KEY=your-fernet-encryption-key-32-bytes-base64
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ============================================================================
# Monitoring & Logging
# ============================================================================
# Sentry (Error Tracking)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_TRACES_SAMPLE_RATE=0.1  # 10% of transactions
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Log Level
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# ============================================================================
# Security
# ============================================================================
# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://altcare.health,https://www.altcare.health

# JWT Settings
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_STORAGE_URL=redis://localhost:6379/2

# ============================================================================
# 2FA Settings
# ============================================================================
TOTP_ISSUER=AltCare
TOTP_WINDOW=1  # Allow 1 window drift (30 seconds)

# ============================================================================
# Internationalization
# ============================================================================
DEFAULT_LANGUAGE=en  # en (English) or bn (Bengali)
SUPPORTED_LANGUAGES=en,bn
FALLBACK_LANGUAGE=en

# ============================================================================
# Feature Flags
# ============================================================================
ENABLE_AI_ASSISTANT=True
ENABLE_2FA=True
ENABLE_GEOLOCATION=True
ENABLE_PAYMENT_GATEWAYS=True
ENABLE_BENGALI_LANGUAGE=True

# ============================================================================
# Development Only
# ============================================================================
# Auto-reload on code changes
RELOAD=True

# SQL Query Echo (set to False in production)
SQL_ECHO=False

# Fake data seeding
SEED_DATABASE=False
SEED_TENANT_COUNT=5
SEED_PATIENTS_PER_TENANT=50
