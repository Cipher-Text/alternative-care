# AltCare Environment Variables
# Copy this file to .env and fill in actual values

# ============================================================================
# Application
# ============================================================================
ENVIRONMENT=development  # development, staging, production
DEBUG=True
SECRET_KEY=your-super-secret-jwt-signing-key-change-this-in-production
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000

# ============================================================================
# Database
# ============================================================================
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/altcare
# Optional: owner/superuser URL used only by Alembic. Point DATABASE_URL at a least-privileged role
# (see backend/scripts/grant_app_role.sql) so PostgreSQL row-level security is enforced.
# MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/altcare
# For production managed database:
# DATABASE_URL=postgresql+asyncpg://user:pass@managed-db.provider.com:5432/altcare

# Database Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600

# ============================================================================
# Redis
# ============================================================================
REDIS_URL=redis://localhost:6379/0
# For production managed Redis:
# REDIS_URL=redis://user:pass@managed-redis.provider.com:6379/0

# ============================================================================
# Celery (uses Redis)
# ============================================================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ============================================================================
# File storage (S3-compatible): Cloudflare R2 in production, MinIO locally
# ============================================================================
# Local development (MinIO from docker compose). Run `python scripts/init_storage.py` once to create the
# bucket and let the public/ folder be read without signing.
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_BUCKET=altcare
STORAGE_REGION=auto
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/altcare

# Cloudflare R2 (production). Create an R2 API token with Object Read & Write on this one bucket, and
# give the bucket a public custom domain (R2 dashboard > bucket > Settings > Custom Domains). Only
# objects under public/ (clinic logos) are meant to be read through that domain; everything under
# private/ is read through short-lived signed URLs. Production refuses to start with localhost values.
# STORAGE_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_ACCESS_KEY_ID=<r2-access-key-id>
# STORAGE_SECRET_ACCESS_KEY=<r2-secret-access-key>
# STORAGE_BUCKET=altcare-prod
# STORAGE_PUBLIC_BASE_URL=https://files.example.com

# ============================================================================
# OpenAI API (for AI/RAG features)
# ============================================================================
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_COMPLETION_MODEL=gpt-4o-mini
# Use gpt-4o for complex queries only (more expensive):
# OPENAI_ADVANCED_MODEL=gpt-4o

# Monthly budget limit (set in OpenAI dashboard)
OPENAI_MONTHLY_BUDGET=500

# ============================================================================
# Checkout (AltCare's own subscriptions and credit top-ups)
# ============================================================================
# TEST-ONLY fake payment gateway: a signed-in doctor can "pay" without paying.
# Use true in local development only. The app refuses to start in production
# (ENVIRONMENT=production) with this set to true.
PAYMENT_FAKE_GATEWAY_ENABLED=false

# ============================================================================
# Platform SMS — owned by AltCare, never configured by clinics. Clinics send
# through this provider and are charged messaging credits (plan allowance first,
# then purchased credits). Leave SMS_PROVIDER empty to disable platform SMS.
# ============================================================================
SMS_PROVIDER=
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=
# Optional: override the provider's default endpoint
BULKSMSBD_API_URL=

# ============================================================================
# Email Providers — the platform's email (system mail AND clinic emails to
# patients, which are charged as messaging credits)
# ============================================================================
# Set EMAIL_PROVIDER to the one you're using: sendgrid | resend | mailgun |
# smtp2go | smtp. Only that provider's credentials need to be filled in —
# leave the rest blank. All send over SMTP relay (see
# backend/app/core/system_email.py), so no per-provider SDK is required.
EMAIL_PROVIDER=resend
EMAIL_FROM_ADDRESS=noreply@altcare.health

# sendgrid
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here

# resend
RESEND_API_KEY=re_your-resend-api-key-here

# mailgun — SMTP credentials from the Mailgun dashboard (per sending
# domain), not the general Mailgun API key. MAILGUN_SMTP_HOST=
# smtp.eu.mailgun.org for EU-region domains.
MAILGUN_SMTP_USERNAME=postmaster@your-domain.mailgun.org
MAILGUN_SMTP_PASSWORD=your-mailgun-smtp-password
MAILGUN_SMTP_HOST=smtp.mailgun.org

# smtp2go — from Sending > SMTP Users in the SMTP2GO dashboard
SMTP2GO_USERNAME=your-smtp2go-username
SMTP2GO_PASSWORD=your-smtp2go-password

# smtp — generic fallback for any other provider
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=True

# ============================================================================
# Google Sign-In
# ============================================================================
# Create an OAuth Client ID (Web application type) at
# https://console.cloud.google.com/apis/credentials with Authorized
# JavaScript origins set to your frontend URL(s). Not a secret — the same
# value is used by the backend (to verify tokens) and the frontend (to
# render the Google button), so it's also exposed as NEXT_PUBLIC_ below.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ============================================================================
# Public site (frontend, build-time NEXT_PUBLIC_*)
# ============================================================================
# Canonical site URL: used for sitemap.xml, robots.txt and share cards.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shown on the privacy/terms/disclaimer pages when set (the "Contact" section is hidden otherwise).
# Public contact channels, shown on the Contact page and in the footer. A blank one is simply hidden.
# WhatsApp: digits only with country code, e.g. 8801700000000. Facebook: the full https URL of the page.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
# Cookieless Plausible visit statistics. Nothing is loaded unless the domain is set.
NEXT_PUBLIC_ANALYTICS_DOMAIN=
# NEXT_PUBLIC_ANALYTICS_SRC=https://plausible.io/js/script.js

# ============================================================================
# SMS Providers
# ============================================================================
# Primary: Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Secondary: Banglalink SMS API (Bangladesh)
BANGLALINK_API_KEY=your-banglalink-api-key
BANGLALINK_SENDER_ID=AltCare

# ============================================================================
# Payment Gateways
# ============================================================================
# Public base URL of THIS backend. Payment gateways call it back (browser return and, for SSLCommerz, a
# server-to-server notification called IPN), so in production it must be https and reachable from the
# internet. On a laptop the browser returns work with localhost, but IPN needs a public tunnel.
BACKEND_PUBLIC_URL=http://localhost:8000

# SSLCommerz (Bangladesh): cards, bKash, Nagad, Rocket and other mobile banking on one hosted page.
# Leave blank to disable. Sandbox keys come from the SSLCommerz sandbox registration.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_SANDBOX=true  # must be false in production

# bKash tokenized checkout (direct). Leave blank to disable; all four are needed.
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta  # use the live URL from bKash in production
BKASH_IS_SANDBOX=true  # must be false in production

# Stripe (International)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ============================================================================
# Encryption (for storing integration credentials)
# ============================================================================
INTEGRATION_ENCRYPTION_KEY=your-fernet-encryption-key-32-bytes-base64
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ============================================================================
# Monitoring & Logging
# ============================================================================
# Sentry (Error Tracking)
# Optional: leave blank for local development, or set a valid project DSN.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1  # 10% of transactions
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Log Level
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# ============================================================================
# Security
# ============================================================================
# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://altcare.health,https://www.altcare.health

# JWT Settings
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_STORAGE_URL=redis://localhost:6379/2

# ============================================================================
# 2FA Settings
# ============================================================================
TOTP_ISSUER=AltCare
TOTP_WINDOW=1  # Allow 1 window drift (30 seconds)

# ============================================================================
# Internationalization
# ============================================================================
DEFAULT_LANGUAGE=en  # en (English) or bn (Bengali)
SUPPORTED_LANGUAGES=en,bn
FALLBACK_LANGUAGE=en

# ============================================================================
# Feature Flags
# ============================================================================
ENABLE_AI_ASSISTANT=True
ENABLE_2FA=True
ENABLE_GEOLOCATION=True
ENABLE_PAYMENT_GATEWAYS=True
ENABLE_BENGALI_LANGUAGE=True

# ============================================================================
# Development Only
# ============================================================================
# Auto-reload on code changes
RELOAD=True

# SQL Query Echo (set to False in production)
SQL_ECHO=False

# Fake data seeding
SEED_DATABASE=False
SEED_TENANT_COUNT=5
SEED_PATIENTS_PER_TENANT=50
